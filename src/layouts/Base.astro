---
import "../styles/global.css";
import KnowledgeGraph from "../components/KnowledgeGraph.astro";
import OrbitalNav from "../components/OrbitalNav.astro";

export interface Props {
  title?: string;
  description?: string;
  // OG / Twitter card props. If any of these are present, we render
  // an SVG OG image at build time and link to it in the meta tags.
  ogTitle?: string;
  ogSubtitle?: string;
  ogDate?: string;
  ogEyebrow?: string;
}

const {
  title = "Mad River AI",
  description = "Specialized investigation and research agents — automating knowledge work with provenance baked in.",
  ogTitle,
  ogSubtitle,
  ogDate,
  ogEyebrow,
} = Astro.props;

const fullTitle = title === "Mad River AI" ? title : `${title} — Mad River AI`;
const ogImageSlug = ogTitle ? slugify(ogTitle) : "default";
const ogImagePath = ogTitle ? `/og/${slugify(ogTitle)}` : "/og/default";

function slugify(s: string): string {
  return s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 60);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020714" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={`https://madriverai.com${ogImagePath}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle ?? title} />
    <meta property="og:site_name" content="Mad River AI" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://madriverai.com${ogImagePath}`} />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-noise">
    <KnowledgeGraph />
    <OrbitalNav />
    <main class="relative z-10">
      <slot />
    </main>
    <footer class="relative z-10 mt-32 border-t border-white/5 px-6 py-10 text-sm text-ink-400">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 md:flex-row md:items-center">
        <div>
          <span class="font-display text-ink-50">Mad River AI</span>
          <span class="ml-2 text-ink-400">· Avilla, Indiana · est. 2026</span>
        </div>
        <div class="flex gap-6 text-ink-200">
          <a href="https://github.com/Mad-River-AI">github</a>
          <a href="https://madriverai.com">site</a>
          <a href="mailto:ops@madriverai.com">contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
