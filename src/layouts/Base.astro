---
import "../styles/global.css";
import KnowledgeGraph from "../components/KnowledgeGraph.astro";
import OrbitalNav from "../components/OrbitalNav.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mad River AI",
  description = "Specialized investigation and research agents — automating knowledge work with provenance baked in.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020714" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-noise">
    <KnowledgeGraph />
    <OrbitalNav />
    <main class="relative z-10">
      <slot />
    </main>
    <footer class="relative z-10 mt-32 border-t border-white/5 px-6 py-10 text-sm text-ink-400">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 md:flex-row md:items-center">
        <div>
          <span class="font-display text-ink-50">Mad River AI</span>
          <span class="ml-2 text-ink-400">· Avilla, Indiana · est. 2026</span>
        </div>
        <div class="flex gap-6 text-ink-200">
          <a href="https://github.com/Mad-River-AI">github</a>
          <a href="https://madriverai.com">site</a>
          <a href="mailto:ops@madriverai.com">contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
