---
/**
 * OgImage — generate an Open Graph / Twitter card image as a static SVG.
 *
 * Astro renders this at build time. Output: an SVG file in /og/ that's
 * served as image/svg+xml. Twitter and OG consumers render SVG to PNG
 * in their own pipelines; modern clients (Twitter, Slack, iMessage,
 * Discord) handle SVG fine.
 *
 * The image uses the same river-950 / amber-glow / cyan palette as the
 * site so link previews look like the site.
 */
export interface Props {
  title: string;
  subtitle?: string;
  /** small label, e.g. "announcement" or "the work" */
  eyebrow?: string;
  /** when set, shown as a small badge top-right */
  date?: string;
}

const { title, subtitle, eyebrow = "Mad River AI", date } = Astro.props;

// Title needs to fit in the 1200x630 box. Long titles get a smaller font.
const titleLen = title.length;
const titleSize = titleLen > 60 ? 56 : titleLen > 40 ? 68 : 84;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1200 630"
  width="1200"
  height="630"
  role="img"
  aria-label={`${eyebrow} — ${title}`}
>
  <defs>
    <radialGradient id="bg" cx="20%" cy="20%" r="80%">
      <stop offset="0%" stop-color="#0c356b" />
      <stop offset="50%" stop-color="#050f23" />
      <stop offset="100%" stop-color="#020714" />
    </radialGradient>
    <radialGradient id="orb" cx="30%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#f4b942" />
      <stop offset="100%" stop-color="#1a64b8" />
    </radialGradient>
    <linearGradient id="title" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f5d28a" />
      <stop offset="50%" stop-color="#8fc5ff" />
      <stop offset="100%" stop-color="#f4b942" />
    </linearGradient>
    <pattern id="grain" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" fill="rgba(255,255,255,0.04)" />
    </pattern>
  </defs>

  <rect width="1200" height="630" fill="url(#bg)" />
  <rect width="1200" height="630" fill="url(#grain)" />

  <!-- Knowledge graph decoration: 24 nodes scattered in the background -->
  <g opacity="0.4">
    {Array.from({ length: 24 }).map((_, i) => {
      const cx = 100 + ((i * 137) % 1000);
      const cy = 80 + ((i * 89) % 470);
      const r = 2 + (i % 3);
      const cyan = i % 4 !== 0;
      return (
        <circle
          cx={cx}
          cy={cy}
          r={r}
          fill={cyan ? "#56a4f5" : "#f4b942"}
        />
      );
    })}
  </g>

  <!-- A few edges connecting the nodes -->
  <g stroke="#2e84db" stroke-width="0.6" opacity="0.25" fill="none">
    <line x1="200" y1="120" x2="400" y2="280" />
    <line x1="400" y1="280" x2="700" y2="180" />
    <line x1="700" y1="180" x2="950" y2="350" />
    <line x1="950" y1="350" x2="1100" y2="500" />
    <line x1="200" y1="450" x2="500" y2="380" />
    <line x1="500" y1="380" x2="800" y2="500" />
  </g>

  <!-- Hub orb in the bottom-right corner -->
  <g>
    <circle cx="1080" cy="540" r="60" fill="none" stroke="#56a4f5" stroke-opacity="0.4" stroke-width="1.2" stroke-dasharray="4 4" />
    <circle cx="1080" cy="540" r="44" fill="url(#orb)" />
  </g>

  <!-- Eyebrow + date row -->
  <g font-family="ui-monospace, 'JetBrains Mono', monospace">
    <text x="80" y="100" font-size="22" letter-spacing="3" fill="#f5d28a" text-transform="uppercase">
      {eyebrow.toUpperCase()}
    </text>
    {date && (
      <text x="1120" y="100" font-size="22" letter-spacing="2" fill="#7a7d8c" text-anchor="end">
        {date}
      </text>
    )}
  </g>

  <!-- Title -->
  <text
    x="80"
    y="290"
    font-family="Inter, system-ui, sans-serif"
    font-size={titleSize}
    font-weight="600"
    fill="url(#title)"
    letter-spacing="-2"
  >
    {title.length > 35 ? title.slice(0, 32) + "…" : title}
  </text>

  <!-- Subtitle -->
  {subtitle && (
    <text
      x="80"
      y="380"
      font-family="Inter, system-ui, sans-serif"
      font-size="32"
      fill="#c7c9d1"
    >
      {subtitle.length > 70 ? subtitle.slice(0, 67) + "…" : subtitle}
    </text>
  )}

  <!-- Footer brand -->
  <g font-family="ui-monospace, 'JetBrains Mono', monospace" font-size="20" letter-spacing="2" fill="#7a7d8c">
    <text x="80" y="560">MADRIVERAI.COM</text>
    <text x="80" y="590" fill="#3a3d4b" font-size="16">research · agents · provenance</text>
  </g>
</svg>
