---
/**
 * OgScaffold — wraps OgImage in a page route so Astro renders it as
 * /og/<slug>.svg. Used by the Layout to set og:image meta tags.
 */
import OgImage from "../components/OgImage.astro";

export interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  date?: string;
}

const props = Astro.props;
---

<OgImage {...props} />
