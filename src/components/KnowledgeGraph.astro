---
/**
 * KnowledgeGraph — Three.js force-directed graph in the background.
 *
 * Renders a fixed-position canvas that fills the viewport. Nodes drift
 * slowly; edges are short and the graph pulses subtly. Pointer-events
 * are disabled so the canvas doesn't block scrolling.
 *
 * Performance: capped at ~80 nodes, ~120 edges. Mobile detects small
 * viewports and dials node count down to 40.
 */
---

<canvas id="knowledge-graph" aria-hidden="true"></canvas>

<script>
  import * as THREE from "three";

  type Node = { id: number; x: number; y: number; z: number; vx: number; vy: number; vz: number };
  type Edge = { a: number; b: number };

  const isMobile = window.innerWidth < 720;
  const NODE_COUNT = isMobile ? 40 : 80;
  const EDGE_COUNT = isMobile ? 60 : 120;
  const SPEED = 0.04;

  // Seeded RNG so the graph is reproducible across loads
  function mulberry32(seed: number) {
    return function () {
      let t = (seed += 0x6d2b79f5);
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  const rand = mulberry32(0x5e1d);

  // Build a small-world-ish graph: ring of nodes + a handful of long-range edges
  const nodes: Node[] = [];
  for (let i = 0; i < NODE_COUNT; i++) {
    const r = 6 + rand() * 4;
    const theta = (i / NODE_COUNT) * Math.PI * 2 + rand() * 0.3;
    const phi = (rand() - 0.5) * Math.PI * 0.6;
    nodes.push({
      id: i,
      x: r * Math.cos(theta) * Math.cos(phi),
      y: r * Math.sin(phi) * 0.6,
      z: r * Math.sin(theta) * Math.cos(phi),
      vx: 0,
      vy: 0,
      vz: 0,
    });
  }
  const edges: Edge[] = [];
  // ring edges
  for (let i = 0; i < NODE_COUNT; i++) {
    edges.push({ a: i, b: (i + 1) % NODE_COUNT });
    if (i % 6 === 0) edges.push({ a: i, b: (i + 3) % NODE_COUNT });
  }
  // long-range edges
  while (edges.length < EDGE_COUNT) {
    const a = Math.floor(rand() * NODE_COUNT);
    const b = Math.floor(rand() * NODE_COUNT);
    if (a !== b) edges.push({ a, b });
  }

  const canvas = document.getElementById("knowledge-graph") as HTMLCanvasElement;
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 1000);
  camera.position.set(0, 0, 18);

  // Node sprites
  const nodeGeom = new THREE.BufferGeometry();
  const positions = new Float32Array(nodes.length * 3);
  const colors = new Float32Array(nodes.length * 3);
  for (const n of nodes) {
    positions[n.id * 3] = n.x;
    positions[n.id * 3 + 1] = n.y;
    positions[n.id * 3 + 2] = n.z;
    // Mostly cyan, a few amber
    const amber = rand() < 0.12;
    if (amber) {
      colors[n.id * 3] = 0.96;
      colors[n.id * 3 + 1] = 0.73;
      colors[n.id * 3 + 2] = 0.26;
    } else {
      colors[n.id * 3] = 0.34;
      colors[n.id * 3 + 1] = 0.64;
      colors[n.id * 3 + 2] = 0.96;
    }
  }
  nodeGeom.setAttribute("position", new THREE.BufferAttribute(positions, 3));
  nodeGeom.setAttribute("color", new THREE.BufferAttribute(colors, 3));

  const nodeMat = new THREE.PointsMaterial({
    size: 0.18,
    vertexColors: true,
    transparent: true,
    opacity: 0.9,
    sizeAttenuation: true,
    blending: THREE.AdditiveBlending,
  });
  const nodePoints = new THREE.Points(nodeGeom, nodeMat);
  scene.add(nodePoints);

  // Edges as line segments
  const edgePositions = new Float32Array(edges.length * 2 * 3);
  for (let i = 0; i < edges.length; i++) {
    const e = edges[i];
    const a = nodes[e.a];
    const b = nodes[e.b];
    edgePositions[i * 6] = a.x;
    edgePositions[i * 6 + 1] = a.y;
    edgePositions[i * 6 + 2] = a.z;
    edgePositions[i * 6 + 3] = b.x;
    edgePositions[i * 6 + 4] = b.y;
    edgePositions[i * 6 + 5] = b.z;
  }
  const edgeGeom = new THREE.BufferGeometry();
  edgeGeom.setAttribute("position", new THREE.BufferAttribute(edgePositions, 3));
  const edgeMat = new THREE.LineBasicMaterial({
    color: 0x2e84db,
    transparent: true,
    opacity: 0.18,
    blending: THREE.AdditiveBlending,
  });
  const edgeLines = new THREE.LineSegments(edgeGeom, edgeMat);
  scene.add(edgeLines);

  function resize() {
    const w = window.innerWidth;
    const h = window.innerHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  resize();
  window.addEventListener("resize", resize);

  // Force-directed update: pull along edges, repel when too close
  function step() {
    // spring along edges
    for (const e of edges) {
      const a = nodes[e.a];
      const b = nodes[e.b];
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dz = b.z - a.z;
      const dist = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1;
      const target = 2.2;
      const f = (dist - target) * 0.001;
      const fx = (dx / dist) * f;
      const fy = (dy / dist) * f;
      const fz = (dz / dist) * f;
      a.vx += fx;
      a.vy += fy;
      a.vz += fz;
      b.vx -= fx;
      b.vy -= fy;
      b.vz -= fz;
    }
    // repulsion (n^2, fine at 80)
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dz = b.z - a.z;
        const d2 = dx * dx + dy * dy + dz * dz;
        if (d2 < 9) {
          const f = 0.02 / Math.max(d2, 0.5);
          a.vx -= dx * f;
          a.vy -= dy * f;
          a.vz -= dz * f;
          b.vx += dx * f;
          b.vy += dy * f;
          b.vz += dz * f;
        }
      }
    }
    // integrate
    for (const n of nodes) {
      n.vx *= 0.92;
      n.vy *= 0.92;
      n.vz *= 0.92;
      n.x += n.vx * SPEED;
      n.y += n.vy * SPEED;
      n.z += n.vz * SPEED;
    }
    // push positions to buffers
    for (const n of nodes) {
      positions[n.id * 3] = n.x;
      positions[n.id * 3 + 1] = n.y;
      positions[n.id * 3 + 2] = n.z;
    }
    for (let i = 0; i < edges.length; i++) {
      const e = edges[i];
      const a = nodes[e.a];
      const b = nodes[e.b];
      edgePositions[i * 6] = a.x;
      edgePositions[i * 6 + 1] = a.y;
      edgePositions[i * 6 + 2] = a.z;
      edgePositions[i * 6 + 3] = b.x;
      edgePositions[i * 6 + 4] = b.y;
      edgePositions[i * 6 + 5] = b.z;
    }
    nodeGeom.attributes.position.needsUpdate = true;
    edgeGeom.attributes.position.needsUpdate = true;

    // gentle camera rotation
    const t = performance.now() * 0.0001;
    camera.position.x = Math.sin(t) * 1.2;
    camera.position.y = Math.cos(t * 1.3) * 0.6;
    camera.lookAt(0, 0, 0);

    renderer.render(scene, camera);
    requestAnimationFrame(step);
  }
  step();
</script>
