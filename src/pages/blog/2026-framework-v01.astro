    padding: 2px 6px;
    border-radius: 3px;
    color: #e2e8f0;
  }

  strong { color: #e2e8f0; }

  .code-block {
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 20px;
    margin: 0 0 16px;
    overflow-x: auto;
  }

  .code-block pre { margin: 0; }

  .code-block code {
    background: none;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: #a0aec0;
