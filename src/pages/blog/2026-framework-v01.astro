  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--color-accent, #00e5ff);
    margin-bottom: 12px;
    font-weight: 600;
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .lede {
    font-size: 1.1rem;
    color: #a0aec0;
    line-height: 1.65;
    margin: 0;
  }

  section { margin-bottom: 36px; }

  h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 12px;
    color: #e2e8f0;
  }

  p {
    color: #a0aec0;
    line-height: 1.7;
    margin: 0 0 14px;
  }

  ul {
    color: #a0aec0;
    line-height: 1.7;
    padding-left: 20px;
