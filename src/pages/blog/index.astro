---
import Base from "../../layouts/Base.astro";

const posts = [
  {
    slug: "2026-06-21-v0-1-release",
    title: "osint-framework v0.1 — Knowledge & Research lanes",
    date: "2026-06-21",
    summary: "First runnable cut of the framework. Four tools, two agents, sqlite store, CLI. 41 tests, 100% green. Plus an honest retrospective on the two-pass plan-review process that paid for itself.",
    tags: ["release", "framework"],
  },
];
---

<Base title="Blog — Mad River AI">
  <section class="px-6 md:px-12 py-20 max-w-3xl">
    <p class="font-mono text-sm tracking-widest text-amber-soft uppercase mb-6">
      Blog
    </p>
    <h1 class="font-display text-4xl md:text-6xl font-semibold leading-tight mb-12">
      <span class="gradient-text">Notes from</span>
      <span class="text-ink-50"> the river.</span>
    </h1>

    <div class="space-y-8">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="block glass rounded-2xl p-8 hover:border-amber-glow/40 transition-colors"
        >
          <div class="flex items-baseline gap-4 text-sm text-ink-400 font-mono mb-3">
            <span>{post.date}</span>
            <span>·</span>
            {post.tags.map((t, i) => (
              <span>{t}{i < post.tags.length - 1 ? " ·" : ""}</span>
            ))}
          </div>
          <h2 class="font-display text-2xl mb-3">{post.title}</h2>
          <p class="text-ink-200 leading-relaxed">{post.summary}</p>
          <p class="text-amber-soft mt-4 font-mono text-sm">Read →</p>
        </a>
      ))}
    </div>
  </section>
</Base>
