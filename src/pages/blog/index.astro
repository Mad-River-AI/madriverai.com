---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Blog — Mad River AI"
  ogTitle="Blog"
  ogSubtitle="Notes from the river."
  ogEyebrow="blog"
>
  <section class="px-6 md:px-12 py-20 max-w-3xl">
    <p class="font-mono text-sm tracking-widest text-amber-soft uppercase mb-6">
      Blog
    </p>
    <h1 class="font-display text-4xl md:text-6xl font-semibold leading-tight mb-12">
      <span class="gradient-text">Notes from</span>
      <span class="text-ink-50"> the river.</span>
    </h1>

    <div class="space-y-8">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="block glass rounded-2xl p-8 hover:border-amber-glow/40 transition-colors"
        >
          <div class="flex items-baseline gap-4 text-sm text-ink-400 font-mono mb-3">
            <span>{post.data.date.toISOString().slice(0, 10)}</span>
            <span>·</span>
            {(post.data.tags ?? []).map((t: string, i: number) => (
              <span>{t}{i < (post.data.tags?.length ?? 0) - 1 ? " ·" : ""}</span>
            ))}
          </div>
          <h2 class="font-display text-2xl mb-3">{post.data.title}</h2>
          <p class="text-ink-200 leading-relaxed">{post.data.summary}</p>
          <p class="text-amber-soft mt-4 font-mono text-sm">Read →</p>
        </a>
      ))}
    </div>
  </section>
</Base>
