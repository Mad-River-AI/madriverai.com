---
import Base from "../layouts/Base.astro";
import StatusBadge from "../components/StatusBadge.astro";

const projects = [
  {
    title: "osint-framework",
    href: "https://github.com/Mad-River-AI/osint-framework",
    blurb: "Modular investigation framework — 6 tools (web search, fetch, WHOIS, DNS, cert transparency, tech detect), 2 agent specs (domain-recon, company-investigator), DAG-based task runner with full provenance chain. 49 tests, 100% green.",
    tags: ["python", "osint", "MIT"],
    status: "alpha" as const,
    year: "2026",
  },
  {
    title: "agent-specs",
    href: "https://github.com/Mad-River-AI/agent-specs",
    blurb: "Canonical agent definitions, prompts, and eval scenarios. Specs-as-code: every agent improvement is a versioned diff. Ships with domain-recon and company-investigator specs, each with ≥5 eval scenarios.",
    tags: ["specs", "prompts", "MIT"],
    status: "alpha" as const,
    year: "2026",
  },
  {
    title: "infra",
    href: "https://github.com/Mad-River-AI/infra",
    blurb: "Docker Compose stacks for SearXNG, Tor proxy, HashiCorp Vault, and Qdrant. Runbooks for initial VPS setup and Vault initialization. Secrets stay in Vault — only .env.example templates in git.",
    tags: ["ops", "self-hosted", "MIT"],
    status: "alpha" as const,
    year: "2026",
  },
  {
    title: "Trend Oracle",
    href: null,
    blurb: "Enterprise trend prediction engine. Cross-platform signal collection from TikTok, Instagram, Reddit, and Twitter/X. Predicts what's going mainstream 4–12 weeks before it does, with every prediction timestamped so clients can audit it.",
    tags: ["enterprise", "prediction", "private"],
    status: "coming-soon" as const,
    year: "2026",
  },
];
---

<Base
  title="Projects — Mad River AI"
  ogTitle="Projects"
  ogSubtitle="Open-source core, public repos, public roadmaps."
  ogEyebrow="projects"
>
  <section class="px-6 md:px-12 py-20 max-w-5xl">
    <p class="font-mono text-sm tracking-widest text-amber-soft uppercase mb-6">
      Projects
    </p>
    <h1 class="font-display text-4xl md:text-6xl font-semibold leading-tight mb-12">
      <span class="gradient-text">The work,</span>
      <span class="text-ink-50"> in public.</span>
    </h1>
    <p class="text-xl text-ink-200 leading-relaxed mb-12 max-w-3xl">
      Open-source core, public repos, public roadmaps. The
      interesting bits — proprietary data sources, customer UX — live
      in private repos and ship as managed services.
    </p>

    <div class="space-y-6">
      {projects.map((p) => (
        <div class="glass-strong rounded-3xl p-8 md:p-10">
          <div class="flex items-baseline gap-4 text-sm text-ink-400 font-mono mb-3">
            <span>{p.year}</span>
            <span>·</span>
            <StatusBadge status={p.status} />
          </div>
          <h2 class="font-display text-2xl md:text-3xl mb-3">{p.title}</h2>
          <p class="text-ink-200 leading-relaxed mb-4 max-w-2xl">{p.blurb}</p>
          <div class="flex flex-wrap items-center gap-3">
            <div class="flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="text-xs font-mono uppercase tracking-wider px-2 py-1 rounded border border-ink-600 text-ink-200">
                  {t}
                </span>
              ))}
            </div>
            {p.href && (
              <a
                href={p.href}
                target="_blank"
                rel="noopener"
                class="ml-auto text-amber-soft font-mono text-sm hover:text-amber-glow transition-colors"
              >
                GitHub →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
