---
import Base from "../layouts/Base.astro";
---

<Base
  ogTitle="Research, agents, and the knowledge that drives them."
  ogSubtitle="Mad River AI — Avilla, Indiana — est. 2026"
  ogEyebrow="home"
>
  <section class="hero relative min-h-screen flex items-center px-6 md:px-12">
    <div class="max-w-3xl">
      <p class="font-mono text-sm tracking-widest text-amber-soft uppercase mb-6">
        Mad River AI · est. 2026 · Avilla, IN
      </p>
      <h1 class="font-display text-5xl md:text-7xl font-semibold leading-tight mb-6">
        <span class="gradient-text">Research, agents,</span><br />
        <span class="text-ink-50">and the knowledge that drives them.</span>
      </h1>
      <p class="text-lg md:text-xl text-ink-200 max-w-2xl leading-relaxed mb-10">
        We build specialized investigation and research agents — open-source
        core, with provenance baked in. Local-first. Human-in-the-loop.
        Composable. Legal by design.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/projects" class="btn-primary">
          See our work →
        </a>
        <a href="/mission" class="btn-ghost">
          Read the mission
        </a>
      </div>
      <div class="mt-16 flex items-center gap-6 text-sm text-ink-400 font-mono">
        <span><span class="text-amber-glow">●</span> 6 tools shipped</span>
        <span><span class="text-amber-glow">●</span> 2 agents in beta</span>
        <span><span class="text-amber-glow">●</span> 49 tests, 100% green</span>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 py-24 max-w-5xl">
    <h2 class="font-mono text-sm tracking-widest text-amber-soft uppercase mb-4">
      What we do
    </h2>
    <p class="text-2xl md:text-3xl text-ink-50 leading-snug mb-12 max-w-3xl">
      Automating the knowledge & research work a careful human
      investigator would do — but faster, repeatable, and with
      provenance baked in.
    </p>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="glass rounded-2xl p-6">
        <div class="text-amber-glow font-mono text-xs tracking-widest uppercase mb-3">01</div>
        <h3 class="text-lg font-display mb-2">OSINT Framework</h3>
        <p class="text-ink-200 text-sm leading-relaxed">
          <a href="https://github.com/Mad-River-AI/osint-framework">osint-framework</a> — modular
          Python framework for OSINT investigations. Six tools, two agents, full provenance chain. MIT licensed.
        </p>
      </div>
      <div class="glass rounded-2xl p-6">
        <div class="text-amber-glow font-mono text-xs tracking-widest uppercase mb-3">02</div>
        <h3 class="text-lg font-display mb-2">Trend Oracle</h3>
        <p class="text-ink-200 text-sm leading-relaxed">
          Enterprise trend prediction engine. We identify what's going
          mainstream 4–12 weeks before it does — across TikTok, Instagram,
          Reddit, and Twitter/X. <em class="text-amber-soft not-italic">Coming.</em>
        </p>
      </div>
      <div class="glass rounded-2xl p-6">
        <div class="text-amber-glow font-mono text-xs tracking-widest uppercase mb-3">03</div>
        <h3 class="text-lg font-display mb-2">Intelligence-as-a-Service</h3>
        <p class="text-ink-200 text-sm leading-relaxed">
          Custom OSINT investigations — due diligence, corporate intelligence,
          domain recon — delivered as structured, sourced, auditable reports.
          <em class="text-amber-soft not-italic">Contact us.</em>
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 py-24 max-w-5xl">
    <h2 class="font-mono text-sm tracking-widest text-amber-soft uppercase mb-4">
      Recent
    </h2>
    <a href="/blog/2026-10-07-framework-alpha" class="block glass-strong rounded-3xl p-8 md:p-10 hover:border-amber-glow/40 transition-colors">
      <div class="flex items-baseline gap-4 text-sm text-ink-400 font-mono mb-3">
        <span>2026-10-07</span>
        <span>·</span>
        <span>announcement</span>
      </div>
      <h3 class="font-display text-2xl md:text-3xl mb-3">
        osint-framework — We open-sourced our investigation core
      </h3>
      <p class="text-ink-200 leading-relaxed max-w-2xl">
        Six modular tools, two production agent specs, and the provenance-tagged
        runner that ties them together. Here's what shipped and why we built it
        this way.
      </p>
      <p class="text-amber-soft mt-6 font-mono text-sm">Read the post →</p>
    </a>
  </section>
</Base>

<style>
  .btn-primary, .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 500;
    transition: all 0.15s ease;
    text-decoration: none;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--color-amber-glow), var(--color-river-400));
    color: var(--color-river-950);
    box-shadow: 0 10px 30px -10px rgba(244, 185, 66, 0.4);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 15px 40px -10px rgba(244, 185, 66, 0.6);
  }
  .btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-ink-50);
    backdrop-filter: blur(10px);
  }
  .btn-ghost:hover {
    border-color: var(--color-amber-glow);
    color: var(--color-amber-glow);
  }
</style>
